# Supabase project — Settings → Data API (URL) / Project API keys (anon public key)
# Must be EXPO_PUBLIC_-prefixed to be readable in the client bundle at all —
# that's Expo's own convention, not a mistake.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
